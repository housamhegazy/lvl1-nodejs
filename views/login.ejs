<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
  <script src="./js/color-modes.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="./css/dark-light.css" />
    <style>
        body { 
            display: flex; 
            flex-direction: column; /* Changed to column to stack navbar and content */
            min-height: 100vh; 
            /* background-color: #f0f2f5;  */
            font-family: Arial, sans-serif; 
        }
        .content-wrapper { /* New wrapper to center the login form */
            display: flex;
            justify-content: center;
            align-items: center;
            flex-grow: 1; /* Allows the wrapper to fill available space */
            padding-top: 20px;
            padding-bottom: 20px;
        }
        .login-container { 
            width: 100%; 
            max-width: 400px; 
            padding: 2.5rem; 
            /* background-color: #fff;  */
            border-radius: 8px; 
            box-shadow: 0 4px 12px rgba(223, 220, 220, 0.1); 
            animation: fadeIn 0.8s ease-out; 
        }
        
        .login-container h2 { font-size: 1.75rem; font-weight: 600; color: #39457a; margin-bottom: 1.5rem; text-align: center; }
        .form-control { border-radius: 6px; border: 1px solid #ddd; padding: 0.75rem; font-size: 1rem; }
        .btn-primary { background-color: #007bff; border-color: #007bff; font-weight: bold; font-size: 1rem; border-radius: 6px; transition: background-color 0.3s, transform 0.3s; }
        .btn-primary:hover { background-color: #0056b3; transform: translateY(-2px); }
        .login-container p a { color: #007bff; text-decoration: none; font-weight: 600; }
        .login-container p a:hover { text-decoration: underline; }
        .alert { margin-bottom: 1.5rem; border-radius: 6px; font-size: 0.95rem; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <%- include('./components/navbar.ejs') %>
    <div class="content-wrapper">
        <div class="login-container">
            <h2>تسجيل الدخول</h2>
            <% if (message) { %>
                <div class="alert alert-danger text-center" role="alert">
                    <%= message %>
                </div>
            <% } %>
            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label">البريد الإلكتروني</label>
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">كلمة المرور</label>
                    <input type="password" class="form-control" id="password" name="password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-3">دخول</button>
            </form>
            <p class="text-center mt-3">
                لا تملك حسابًا؟ <a href="/register">أنشئ حسابًا جديدًا</a>
            </p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('./components/dark-light.ejs') %>
</body>
</html>
<!DOCTYPE html>
<html lang="en" data-bs-theme="auto">
<head>
  <script src="./js/color-modes.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل حساب جديد</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="./css/dark-light.css" />
    
    <style>
        /* التنسيقات الأساسية للصفحة */
        body { 
            display: flex; 
            flex-direction: column; /* Changed to column to stack navbar and content */
            min-height: 100vh; 
            /* background-color: #f0f2f5;  */
            font-family: 'Arial', sans-serif; 
        }

        /* حاوية نموذج التسجيل */
        .register-container {
            width: 100%;
            max-width: 500px;
            padding: 2.5rem;
            /* background-color: #fff; */
            border-radius: 8px;
            box-shadow: 0 4px 12px rgba(143, 142, 142, 0.1);
            animation: fadeIn 0.8s ease-out;
        }

        /* حاوية جديدة لتغليف المحتوى وتنسيقه */
        .content-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-grow: 1; /* Allows the wrapper to fill available space */
            padding-top: 20px;
            padding-bottom: 20px;
        }

        /* عنوان النموذج */
        .register-container h2 {
            font-size: 2rem;
            font-weight: 600;
            color: #191cbb;
            margin-bottom: 2rem;
            text-align: center;
        }

        /* تنسيق حقول الإدخال */
        .form-control {
            border-radius: 6px;
            border: 1px solid #ddd;
            padding: 0.75rem;
            font-size: 1rem;
        }

        /* تنسيق الأزرار */
        .btn-primary {
            background-color: #28a745;
            border-color: #28a745;
            font-weight: bold;
            font-size: 1.1rem;
            border-radius: 6px;
            transition: background-color 0.3s, transform 0.3s;
        }

        .btn-primary:hover {
            background-color: #218838;
            transform: translateY(-2px);
        }

        .register-container p a {
            color: #007bff;
            text-decoration: none;
            font-weight: 600;
        }

        .register-container p a:hover {
            text-decoration: underline;
        }

        .alert {
            margin-bottom: 1.5rem;
            border-radius: 6px;
            font-size: 0.95rem;
        }

        /* حركة الظهور */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    
    <%- include('./components/navbar.ejs') %>  

    <div class="content-wrapper">
        <div class="register-container">
            <h2>إنشاء حساب جديد</h2>
            
            <% if (message) { %>
                <div class="alert alert-danger text-center" role="alert">
                    <%= message %>
                </div>
            <% } %>

            <form action="/register" method="POST">
                <div class="mb-3">
                    <label for="fullName" class="form-label">الاسم بالكامل</label>
                    <input type="text" class="form-control" id="fullName" name="fullName" placeholder="أدخل اسمك بالكامل" required>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">البريد الإلكتروني</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="أدخل بريدك الإلكتروني" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">كلمة المرور</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="أدخل كلمة مرور قوية" required>
                </div>
                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">تأكيد كلمة المرور</label>
                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="أعد إدخال كلمة المرور" required>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 mt-4">تسجيل</button>
            </form>

            <p class="text-center mt-3">
                هل لديك حساب بالفعل؟ <a href="/login">سجل الدخول من هنا</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<%- include('./components/dark-light.ejs') %>
</body>
</html>